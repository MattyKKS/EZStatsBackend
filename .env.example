# ---- Database (PostgreSQL in Docker) ----
# Local dev (NestJS runs on host, Postgres in Docker): host = localhost
DATABASE_URL="postgresql://ezstats:ezstats@localhost:5432/ezstats?schema=public"

# Postgres container credentials (used by docker-compose)
POSTGRES_USER=ezstats
POSTGRES_PASSWORD=ezstats
POSTGRES_DB=ezstats

# ---- API ----
PORT=4000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000

# ---- AI worker output ingestion ----
# Root of the AI worker's per-run output folders; a match's runId names the
# subfolder (outputs/<runId>/) that holds match_report_merged.json, the overlay
# video, and player_crops/. Shared volume in prod.
WORKER_OUTPUTS_DIR=
# Fallback run served when a match has no runId yet (e.g. the demo/<run> folder).
# Lets the analysis dashboard show data before any real run is linked.
WORKER_DEMO_DIR=

# ---- Video transcoding (ffmpeg) ----
# Uploaded videos are transcoded to browser-playable H.264 when the source codec
# isn't. Leave blank to use `ffmpeg`/`ffprobe` from PATH, or set full paths.
FFMPEG_PATH=
FFPROBE_PATH=

# ── AI worker invocation ──────────────────────────────────────────────────────
# The backend runs the AI worker as a child process on the uploaded video.
#
# DISABLED BY DEFAULT. A full run takes minutes to hours depending on clip
# length and whether a GPU is present, which is longer than a live demo can
# wait, so presentations use pre-computed runs instead. Set to "true" to make an
# upload start processing automatically; either way the code path is exercised
# by POST /matches/:id/process.
AI_WORKER_AUTORUN=false

# Path to the AI worker repository (contains run_pipeline_v2.py).
AI_WORKER_DIR=../Desktop/EZ Stats AI Worker

# Python interpreter that has the worker's dependencies installed.
# On Windows this is usually the worker's venv:
#   AI_WORKER_PYTHON=../Desktop/EZ Stats AI Worker/.venv/Scripts/python.exe
AI_WORKER_PYTHON=python
