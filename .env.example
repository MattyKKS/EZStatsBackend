# ---- Database (PostgreSQL in Docker) ----
# Local dev (NestJS runs on host, Postgres in Docker): host = localhost
DATABASE_URL="postgresql://ezstats:ezstats@localhost:5432/ezstats?schema=public"

# Postgres container credentials (used by docker-compose)
POSTGRES_USER=ezstats
POSTGRES_PASSWORD=ezstats
POSTGRES_DB=ezstats

# ---- API ----
PORT=4000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000

# ---- AI worker output ingestion (later phases) ----
# Path to the EZ Stats AI Worker outputs/ folder (shared volume in prod).
# Leave blank for now; team management does not need it.
WORKER_OUTPUTS_DIR=
